# Copy this file to .env and fill in your key. .env is gitignored and must
# never be committed. The live conformance suite and the learner terminal read
# it; nothing in src/ touches environment files.
#
#   cp .env.example .env
#   pnpm test:live     # the provider suite, against a real model
#   pnpm learn         # the terminal, where `x` asks for another explanation
#
# With this unset, `pnpm learn` says plainly that no model is connected and
# runs exactly as it did before — deterministic, and nothing leaves the machine.
#
# Turns the provider on. Absent or not "1" means the engine runs
# deterministically with no model behind ReasoningPort.
LUMINA_REASONING_ENABLED=1

# Your Anthropic API key. No quotes, no spaces around the =.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Only needed if your key is "identity-linked" — you will know because the API
# returns: "anthropic-workspace-id is required when authenticating with an
# identity-linked API key". Find the id in the Console URL when you have a
# workspace open: platform.claude.com/workspaces/<this-part>/...
# Leave commented out if your key works without it.
# ANTHROPIC_WORKSPACE_ID=wrkspc_01your-workspace-id

{
  "name": "math-lumina-learning-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless Math Lumina Learning Engine domain, decisioning, event-loop, knowledge-pedagogy, and delivery-contract kernels \u2014 Phase 2 Slices 1\u20135.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "demo:slice2": "tsx demo/slice2-scenario.ts",
    "demo:slice3": "tsx demo/slice3-event-loop.ts",
    "demo:slice4": "tsx demo/slice4-knowledge-pedagogy.ts",
    "demo:slice5": "tsx demo/slice5-learning-experience-delivery.ts",
    "test:live": "tsx --test live/**/*.test.ts",
    "learn": "tsx cli/learn.ts",
    "build:web": "esbuild web/app.ts --bundle --format=iife --target=es2022 --outfile=web/app.js && node web/verify.mjs",
    "ui": "pnpm build:web && node web/serve.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0"
  }
}
